  "cards": [
    {
      "dot": "cyan",
      "title": "Two engines, one contract",
      "items": [
        "v1: explicit message list and sequential tool caller",
        "v2: LangGraph call_model to execute_tools conditional edges",
        "Both return AgentOutcome and write the same transcript.jsonl"
      ]
    },
    {
      "dot": "amber",
      "title": "Deterministic evidence",
      "items": [
        "Verdicts come from artifacts, never from model self-report",
        "seed_manifest.json prevents planted-canary false positives",
        "Failed tool calls and held emails never score as success"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-closed boundaries",
      "items": [
        "Path jail on every read_file and write_file",
        "fetch_url is allow-listed to the staging origin",
        "send_email writes local JSONL; Defense v1 gates external mail"
      ]
    },
    {
      "dot": "emerald",
      "title": "Closed evidence loop",
      "items": [
        "Runner persists one results.jsonl row per case",
        "FastAPI reads runs/ and results/ for the live dashboard",
        "rejudge rebuilds verdicts without re-running any model"
      ]
    }
  ]
