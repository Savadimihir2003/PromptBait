  "cards": [
    {
      "dot": "cyan",
      "title": "Same contract, two engines",
      "items": [
        "Both receive the same system prompt, tool schemas, and defense config",
        "Both emit the same Step objects to transcript.jsonl",
        "Both return an AgentOutcome the judge can score"
      ]
    },
    {
      "dot": "amber",
      "title": "Where they differ",
      "items": [
        "v1 keeps messages in a plain list and loops with a for-range",
        "v2 passes typed AgentGraphState through call_model and execute_tools nodes",
        "Only the control flow changes; the observable evidence does not"
      ]
    },
    {
      "dot": "rose",
      "title": "Deterministic verdict",
      "items": [
        "The judge compares artifacts against seed_manifest.json",
        "Model self-report is never the source of truth",
        "Failed tool calls and gated emails cannot score a win"
      ]
    }
